// Prisma Schema for API Request Studio
// Run: npx prisma generate && npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users & Auth (NextAuth.js v5 compatible)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  requests      RequestHistory[]
  collections   Collection[] @relation("CollectionOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// Workspaces
model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  collections Collection[]
  environments Environment[]
  invitations Invitation[]
  requestHistory RequestHistory[]
}

model WorkspaceMember {
  id          String       @id @default(cuid())
  userId      String
  workspaceId String
  role        MemberRole   @default(EDITOR)
  joinedAt    DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}

enum MemberRole {
  ADMIN
  EDITOR
  VIEWER
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  workspaceId String
  role        MemberRole @default(EDITOR)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Collections & Requests
model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  workspaceId String
  ownerId     String
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User          @relation("CollectionOwner", fields: [ownerId], references: [id])
  parent      Collection?   @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Collection[]  @relation("CollectionHierarchy")
  requests    Request[]
  variables   CollectionVariable[]
}

model Request {
  id            String       @id @default(cuid())
  name          String
  description   String?      @db.Text
  method        HttpMethod
  url           String
  headers       Json         @default("[]")
  queryParams   Json         @default("[]")
  body          Json?
  bodyType      BodyType     @default(NONE)
  auth          Json?
  settings      Json         @default("{}")
  collectionId  String
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  collection    Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  history       RequestHistory[]
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum BodyType {
  NONE
  JSON
  FORM_DATA
  URLENCODED
  RAW
  BINARY
  GRAPHQL
}

// Environments & Variables
model Environment {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variables   EnvironmentVariable[]
}

model EnvironmentVariable {
  id            String        @id @default(cuid())
  key           String
  value         String
  type          VariableType  @default(DEFAULT)
  description   String?
  environmentId String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  environment   Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  @@unique([environmentId, key])
}

enum VariableType {
  DEFAULT
  SECRET
}

model CollectionVariable {
  id            String        @id @default(cuid())
  key           String
  value         String
  type          VariableType  @default(DEFAULT)
  description   String?
  collectionId  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@unique([collectionId, key])
}

// History
model RequestHistory {
  id              String   @id @default(cuid())
  userId          String
  requestId       String?
  workspaceId     String
  method          HttpMethod
  url             String
  headers         Json
  queryParams     Json
  body            Json?
  bodyType        BodyType
  auth            Json?

  // Response
  statusCode      Int?
  statusText      String?
  responseHeaders Json?
  responseBody    String?    @db.Text
  responseTime    Int?     // ms
  timing          Json?    // DNS, TCP, TLS, TTFB, download
  error           String?

  createdAt       DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  request         Request?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([requestId])
}